# Veritabanı (npm run db:dev ile gömülü PostgreSQL açılır)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/burgermash"

# JWT (üretimde uzun, rastgele bir değer kullanın)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# İzin verilen ön yüz adresleri (virgülle ayırın)
CORS_ORIGINS="http://localhost:3000"

PORT=4000

# Sadece demo / seed için başlangıç hesapları
SEED_ADMIN_EMAIL="admin@burgermash.dev"
SEED_ADMIN_PASSWORD="admin12345"
SEED_KITCHEN_EMAIL="mutfak@burgermash.dev"
SEED_KITCHEN_PASSWORD="mutfak12345"
