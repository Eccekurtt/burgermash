generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  KITCHEN
  ADMIN
}

enum Category {
  BURGER
  YAN
  TATLI
  ICECEK
}

enum OptionKind {
  EXTRA
  SAUCE
}

enum OrderStatus {
  RECEIVED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id            String   @id // okunabilir slug: "klasik", "patates"...
  name          String
  description   String
  price         Int // TL
  category      Category
  imageUrl      String
  tag           String?
  available     Boolean  @default(true)
  sortOrder     Int      @default(0)
  ingredients   String[] // üründen çıkarılabilen malzemeler
  calories      Int? // yaklaşık kcal
  allergens     String[] @default([]) // gluten, milk, egg, sesame, soy, mustard, nuts
  dietary       String[] @default([]) // vegan, vegetarian, spicy
  // Menüde yan ürün / içecek olarak seçilebiliyorsa fiyat farkı (null = seçilemez)
  menuSideDelta  Int?
  menuDrinkDelta Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Option {
  id        String     @id // "x-bacon", "s-ranch"...
  kind      OptionKind
  name      String
  price     Int
  color     String? // soslar için nokta rengi
  available Boolean    @default(true)
  sortOrder Int        @default(0)
}

model Setting {
  key   String @id
  value Json
}

model Order {
  id         String      @id @default(cuid())
  user       User?       @relation(fields: [userId], references: [id])
  userId     String?
  status     OrderStatus @default(RECEIVED)
  subtotal   Int
  discount   Int         @default(0)
  total      Int
  promo      String?
  customerName  String
  phone         String?
  address       String?
  note          String?
  fulfillment   String   @default("delivery") // delivery | pickup
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String? // özel burgerlerde null
  name      String
  unitPrice Int
  qty       Int
  details   String[]
  imageUrl  String?
  config    Json? // siparişin ham seçimleri: "tekrar sipariş ver" için
}
